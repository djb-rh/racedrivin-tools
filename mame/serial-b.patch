@@ -1504,6 +1595,13 @@ void harddriv_state::driver_nomsp(machine_config &config)
 	rs232_port_device &rs232(RS232_PORT(config, "rs232", default_rs232_devices, nullptr));
 	rs232.rxd_handler().set("duartn68681", FUNC(mc68681_device::rx_a_w));
 
+	// Serial B (J3).  Fitted on every Hard/Race Drivin' board but unused by the stock
